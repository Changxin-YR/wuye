# ---------- secrets & local config ----------
.env
.env.local
.env.*.local
*.pem
*.key

# keep the template (must stay tracked)
!.env.example

# ---------- virtualenv / python ----------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- runtime state ----------
/instances/
/uploads/*
!uploads/.gitkeep

# internal team state (AgentTeams) - never published
/.agent-teams/

# ---------- local evidence, logs and handoff material (never published) ----------
/artifacts/
/HANDOFF/
/checkpoint_evidence/
/demo-logs/
/tests/_legacy/

# ---------- previous rewrite iterations (kept on disk only) ----------
/_legacy/

# ---------- publishing workspace ----------
/.publish/

# ---------- scratch operator scripts at repo root ----------
/_*.sh
/_*.py
# ---------- stale test-run log from the previous iteration (kept on disk) ----------
/docs/CURRENT_FULL_TEST_ATTEMPT.txt
