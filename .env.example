# Copy to .env; keep existing production .env when upgrading.
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=mysql+pymysql://property_user:change-me@127.0.0.1:3306/property_workorder?charset=utf8mb4
AI_PROVIDER=bailian
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
# Also accepts DASHSCOPE_API_KEY when deploying with the Alibaba SDK convention.
BAILIAN_MODEL=qwen-plus
DIFY_TIMEOUT=60
UPLOAD_FOLDER=uploads
HOST=127.0.0.1
PORT=5000
# 1 only when site is served over HTTPS; local HTTP must use 0.
COOKIE_SECURE=0

# Comma-separated R2 actions allowed to execute automatically after normal
# permission/data-scope/business validation. Remove entries to make policy stricter.
AGENT_R2_AUTO_COMMANDS=relation.bind_by_name,lease.create,parking.assign
